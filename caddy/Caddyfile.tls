# Trusted-HTTPS mode. Used when APP_DOMAIN is set (e.g. erp.xenithpulse.com).
#
# Caddy obtains a publicly-trusted Let's Encrypt certificate using the DNS-01
# challenge, so it works even though the box is on a private LAN IP and is not
# reachable from the internet. Browsers and phones trust it with NO per-device
# setup and NO "Not Secure" warning.
#
# Requirements (set in .env):
#   APP_DOMAIN        the hostname, e.g. erp.xenithpulse.com
#   ACME_EMAIL        contact email for Let's Encrypt
#   CADDY_DNS_TOKEN   API token for the DNS provider that hosts the domain
#
# The `dns` provider name below must match the plugin baked into the image
# (DNS_PLUGIN build arg in Caddy.Dockerfile — default: cloudflare). If you use
# a different provider, change both the build arg and this directive.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	tls {
		dns cloudflare {$CADDY_DNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	# Device access control (see Caddyfile.http, including the WARNING there
	# about an empty value locking out the entire LAN). Only client IPs inside
	# POS_ALLOWED_CIDRS may reach the POS; default 0.0.0.0/0 = allow all.
	# Ranges are SPACE-separated, not comma-separated.
	@blocked not remote_ip {$POS_ALLOWED_CIDRS:0.0.0.0/0 ::/0}
	handle @blocked {
		respond "Access to this POS is restricted to authorized devices on this network." 403
	}

	handle {
		# Everything → the Next.js app, realtime (/ws) included: the WebSocket
		# server runs in-process now, so there is no Soketi upstream to split
		# off. Caddy upgrades wss automatically, no extra directive needed.
		reverse_proxy app:3000 {
			# Forward the real host/scheme so next-auth (AUTH_TRUST_HOST) rebuilds
			# its URL from the request — here it resolves to https://{$APP_DOMAIN}
			# and cookies become Secure automatically. Caddy sets these by default;
			# kept explicit to mirror Caddyfile.http.
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
