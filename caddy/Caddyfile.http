# HTTP-only mode (default). Used when APP_DOMAIN is NOT set — i.e. plain-HTTP
# LAN access via the box IP on port 80. Everything, realtime (/ws) included,
# is proxied to the Next.js app — the WebSocket server runs in-process.
:80 {
	# ── Device access control (vendor-agnostic, no router needed) ────────────
	# Only client IPs inside POS_ALLOWED_CIDRS may reach the POS. Default
	# 0.0.0.0/0 = allow every LAN device (no lockout). Set POS_ALLOWED_CIDRS in
	# .env to e.g. "192.168.1.0/24" to restrict, then: docker compose up -d caddy
	#
	# WARNING: this must never resolve to an EMPTY list. The default below only
	# applies when the variable is UNSET -- a set-but-empty value produces
	# `not remote_ip` with no ranges, which matches EVERY request and 403s the
	# whole LAN. docker-compose.yml guards against that by resolving the
	# allow-all value itself; keep both in place.
	# Ranges are SPACE-separated, not comma-separated.
	@blocked not remote_ip {$POS_ALLOWED_CIDRS:0.0.0.0/0 ::/0}
	handle @blocked {
		respond "Access to this POS is restricted to authorized devices on this network." 403
	}

	handle {
		# Realtime lives INSIDE the app process now (Soketi is gone), so /ws is
		# just another path on the same upstream and needs no separate rule —
		# the catch-all below already carries it. Caddy negotiates the
		# WebSocket upgrade with no extra configuration.
		reverse_proxy app:3000 {
			# Forward the address the browser actually used so next-auth
			# (AUTH_TRUST_HOST) can rebuild its URL from it. This is what lets
			# login follow the box's LAN IP automatically. Caddy sets these by
			# default; kept explicit so the behaviour is obvious on handover.
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
