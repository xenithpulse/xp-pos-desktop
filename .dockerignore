# Build artifacts and local-only files — keep the build context small and avoid
# leaking local secrets into the image.
node_modules
.next
.git
.gitignore
npm-debug.log*

# Local environment / secrets — NEVER copy real secrets into the image.
.env
.env.local
.env.*.local

# Editor / OS noise
.vscode
.idea
.DS_Store
.claude

# Docs and CI not needed at build
*.md
.github

# Local data / backups
data
backups
uploads
tsconfig.tsbuildinfo
