# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the TEMPLATE must ship, or a fresh clone on a client box has no config
# at all (no NEXTAUTH_SECRET, no TENANT_DB) and the app cannot start.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# native installer build artifacts (developer machine only)
# .depcache holds ~700 MB of pinned upstream archives; payload/ and dist/ are
# regenerated by installer\build.ps1 on every run. deps.json IS committed -
# it is what makes the build reproducible.
/installer/.depcache/
/installer/payload/
/installer/dist/
